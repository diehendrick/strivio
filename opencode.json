{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browseros": {
      "type": "remote",
      "url": "http://127.0.0.1:9000/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@playwright/mcp"],
      "enabled": true
    }
  }
}